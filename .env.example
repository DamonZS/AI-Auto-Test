# EXECUTOR_MODEL=gpt-4o-mini

# ---- Neo4j 知识图谱 ----
NEO4J_ENABLED=false        # 设为 false 可关闭知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
